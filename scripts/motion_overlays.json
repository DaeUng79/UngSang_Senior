  "3": {
    "anchor": "top-right",
    "before": {
      "place": "서창동 서창초등학교 운동장",
      "quote": "친구들과 함께 뛰며\n마냥 즐겁기만 했던 릴레이 경주"
    },
    "after": {
      "place": "서창동 서창초등학교 운동장",
      "quote": "이제 내 아이가 다니며\n추억을 쌓고 있습니다."
    }
  },
  "4": {
    "anchor": "top-right",
    "before": {
      "place": "서창초등학교 앞 유미의 집",
      "quote": "카메라를 든 삼촌 앞에서\n밝게 웃으며"
    },
    "after": {
      "place": "서창초등학교 앞\n유미네 담이 있었던 곳",
      "quote": "그 설렘은, 우리 마음 한 켠에\n여전히 남아있습니다."
    }
  },
  "5": {
    "anchor": "top-right",
    "before": {
      "place": "소주동 천성리버타운아파트 인근",
      "quote": "뜨겁던 1995년의 한 날,\n논 도랑 턱에 나란히 앉아서"
    },
    "after": {
      "place": "소주동 천성리버타운아파트 인근",
      "quote": "마을을 뛰놀던 아이들도\n우직하고 성실하게 자라나"
    }
  },
  "6": {
    "anchor": "top-left",
