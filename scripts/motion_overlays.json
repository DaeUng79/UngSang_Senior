    "before": {
      "place": "소주동 원진아파트를 배경으로",
      "quote": "늘 그리운\n우리 할머니"
    },
    "after": {
      "place": "소주동 원진아파트",
      "quote": "여전히 자리를\n지키고 있습니다."
    }
  },
  "7": {
    "anchor": "top-right",
    "before": {
      "place": "소주동 백동마을",
      "quote": "짝다리가\n최고 멋진 포즈라고 생각했던"
    },
    "after": {
      "place": "소주동 백동마을",
      "quote": "또 다른 추억을\n만들어 가고 있습니다."
    }
  },
  "8": {
    "anchor": "top-right",
    "before": {
      "place": "주진동 포도밭이 가득하던\n마을 초가집 앞",
      "quote": "초가집 담벼락에\n기대어 한 장"
    },
    "after": {
      "place": "주진동 포도밭이 가득했던\n그곳 어딘가",
      "quote": "변해가는 세월이\n필름처럼 스쳐갑니다."
    }
  },
  "9": {
    "anchor": "bottom-right",
    "before": {
      "place": "천성산에서 바라본 평산동과 서창동",
      "quote": "푸른 논밭이 가득한 정겨운 동네,\n자연과 함께"
    },
    "after": {
      "place": "천성산에서 바라 본 평산동과 서창동",
      "quote": "더 넓은 세상과 연결되어\n빛나는 도시로 성장하였습니다."
    }
  },
  "10": {
    "anchor": "top-right",
    "before": {
      "place": "평산동 평산휴먼시아 아파트 인근",
      "quote": "동네 주민들이 한마음으로\n삽을 들었던 그때"
    },
    "after": {
      "place": "평산동 평산휴먼시아 아파트 인근",
      "quote": "사람 온기 가득한 내일이\n솟아올랐습니다."
    }
  },
  "11": {
    "anchor": "top-right",
    "before": {
      "place": "서창동 옛 국민아파트 앞 공터",
      "quote": "새빨간 손끝과 코가 시려도\n즐겁게 눈싸움을 하던 날"
    },
    "after": {
      "place": "서창동 옛 국민아파트 자리 인근\n(아크로시티아파트 주변)",
      "quote": "그 공간을 살아갔던 사람들의 추억은\n그자리 그대로 머물러 있습니다."
    }
  },
  "12": {
    "anchor": "top-right",
    "narrow": true,
    "before": {
      "place": "소주동 현재\n웅상119안전센터 인근",
