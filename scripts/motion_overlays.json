{
  "1": {
    "anchor": "top-right",
    "before": {
      "place": "양산시 소주동\n백동마을 당산나무 앞",
      "quote": "당산나무 아래서\n놀고 있는 동생과 나"
    },
    "after": {
      "place": "양산시 소주동\n백동마을 당산나무 앞",
      "quote": "그 자리 그대로\n마을 주민들의 마음의 쉼터로"
    }
  },
  "2": {
    "anchor": "bottom-right",
    "before": {
      "place": "소주동 백동초등학교 운동장",
      "quote": "가족과 동네 이웃들이\n모두 모여 즐거운 시간을 보냈던"
    },
    "after": {
      "place": "소주동 백동초등학교 운동장",
      "quote": "온 동네 주민이 함께하던\n가을운동회, 그 순간이 그립습니다."
    }
